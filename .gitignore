# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Research data — contains real deal data, never commit
docs/research/

# Claude Code memory — contains personal context, never commit
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Local court-scraping run artifacts (large, not app code)
gsccca_runs/

# Hermes tools — local deps (its own package on the VPS)
hermes/node_modules
# Hermes local runtime state (skill on/off overrides) — lives on the VPS, not in git
hermes/data/
