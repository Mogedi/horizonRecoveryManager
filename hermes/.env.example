# Hermes agent tools — copy to .env and fill in. NEVER commit the real .env.
HM_BASE_URL=http://localhost:3000      # dashboard base URL (Vercel prod when live)
HERMES_TOKEN=                          # scoped agent bearer token (must match the dashboard's HERMES_TOKEN)
DATABASE_URL_READONLY=                 # read-only Neon role connection string (SELECT-only)
ANTHROPIC_API_KEY=                     # for triage reasoning (claude-sonnet-4-6)
