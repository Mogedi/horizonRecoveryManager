{
  "name": "hermes-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes agent tools for HorizonManager — read-only case reads (direct Neon) + scoped HTTP writes (HERMES_TOKEN)",
  "bin": { "hermes": "src/cli.js" },
  "scripts": {
    "queue": "node --env-file=.env src/cli.js queue",
    "read": "node --env-file=.env src/cli.js read",
    "triage": "node --env-file=.env src/cli.js triage",
    "bot": "node --env-file=.env src/bot.js",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "discord.js": "^14.16.3",
    "node-cron": "^3.0.3",
    "pg": "^8.21.0"
  }
}
