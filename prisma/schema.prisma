generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: no url/directUrl here. See prisma.config.ts (CLI) and src/lib/db/client.ts (app).
}

// M9+: Multi-source activity event type
enum ActivitySource {
  HUBSPOT
  JUSTCALL
  GOOGLE
  USER
  AI
}

// M9+: Phone number status for dead number detection
enum PhoneStatus {
  active
  disconnected
  invalid
  unknown
}

// M9+: Pipeline group a deal belongs to (derived from stage ID via PIPELINE_GROUP constant)
enum PipelineGroup {
  setup
  outreach
  case_mgmt
  terminal
}

enum SnoozeCategory {
  waiting_on_attorney
  waiting_on_county
  waiting_on_client
  waiting_on_documents
  waiting_on_probate
  filed_normal_wait
  other
}

enum TaskCategory {
  case
  business
  vendor
  legal
  networking
  other
}

enum TaskStatus {
  open
  done
}

// Layer 1 cache — all deals in the pipeline
model Deal {
  id               Int       @id @default(autoincrement())
  hubspotId        String    @unique @map("hubspot_id")
  name             String?
  stage            String?   // stage ID — resolve to name via stageMap; never compare raw strings
  pipeline         String?
  ownerId          String?   @map("owner_id") // mostly Marwa (data entry) — not used for routing
  amount           Decimal?  @db.Decimal(12, 2) // primary display value — confirmed 100% populated
  estimatedSurplus Decimal?  @map("estimated_surplus") @db.Decimal(12, 2) // null on all current deals
  closeDate        DateTime? @map("close_date") @db.Date
  lastActivityDate DateTime? @map("last_activity_date") @db.Timestamptz(6) // notes_last_updated
  stageEnteredAt   DateTime? @map("stage_entered_at") @db.Timestamptz(6)   // hs_v2_date_entered_current_stage
  lastModified     DateTime? @map("last_modified") @db.Timestamptz(6)      // hs_lastmodifieddate — delta filter
  contactCount     Int       @default(0) @map("contact_count")
  propertyAddress  String?   @map("property_address") // properties_address
  county           String?                            // enumeration: 25 GA counties + "Other"
  parcelId         String?   @map("parcel_id")        // parcel_id__deal
  taxSaleDate      DateTime? @map("tax_sale_date") @db.Date
  hubspotUrl       String?   @map("hubspot_url")
  rawPayload       Json?     @map("raw_payload")
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  // M9+ denorm cache — populated by JustCall sync; avoids JOIN on every attention queue load
  callAttemptCount  Int       @default(0) @map("call_attempt_count")
  lastCallAttemptAt DateTime? @map("last_call_attempt_at") @db.Timestamptz(6)

  activities     DealActivity[]
  contacts       DealContact[]
  snoozes        DealSnooze[]
  aiSummary      AiSummary?
  tasks          InternalTask[]
  activityEvents ActivityEvent[]  // M9+
  phoneNumbers   PhoneNumber[]    // M9+
  pipelineStates PipelineState[]  // M9+

  @@map("deals")
}

// Layer 2 cache — notes, emails, calls, tasks per deal (on demand only)
model DealActivity {
  id            Int       @id @default(autoincrement())
  dealHubspotId String    @map("deal_hubspot_id")
  type          String    // note | email | call | task
  body          String?   // HTML-stripped for notes; plain text for others
  authorOwnerId String?   @map("author_owner_id") // hubspot_owner_id on engagement
  direction     String?   // inbound | outbound (email direction — values not fully confirmed)
  timestamp     DateTime? @db.Timestamptz(6)
  metadata      Json?
  rawPayload    Json?     @map("raw_payload")
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("deal_activities")
}

// Layer 2 cache — contacts linked to a deal
model DealContact {
  id               Int      @id @default(autoincrement())
  dealHubspotId    String   @map("deal_hubspot_id")
  contactHubspotId String?  @map("contact_hubspot_id")
  name             String?
  contactType      String?  @map("contact_type")     // contact_type1: owner, heir, attorney, etc.
  ownershipStatus  String?  @map("ownership_status") // ownership_contact_status1
  isDeceased       Boolean  @default(false) @map("is_deceased")
  doNotContact     Boolean  @default(false) @map("do_not_contact")
  phoneNumbers     Json?    @map("phone_numbers") // validated array from all 11 phone field variants
  emailList        Json?    @map("email_list")
  rawPayload       Json?    @map("raw_payload")
  syncedAt         DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("deal_contacts")
}

// Snooze state — internal, not from HubSpot
model DealSnooze {
  id            Int            @id @default(autoincrement())
  dealHubspotId String         @map("deal_hubspot_id")
  category      SnoozeCategory
  freeformNote  String?        @map("freeform_note")
  snoozeUntil   DateTime       @map("snooze_until") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  wokeAt        DateTime?      @map("woke_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("deal_snoozes")
}

// API usage tracking — daily call counter read from here (not in-memory)
model SyncLog {
  id           Int       @id @default(autoincrement())
  syncType     String?   @map("sync_type")      // layer1_all | layer2_deal | manual
  apiCallsMade Int?      @map("api_calls_made")
  dealsSynced  Int?      @map("deals_synced")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  error        String?

  @@map("sync_log")
}

// AI-generated per-deal summaries — generated on demand, never auto-triggered
model AiSummary {
  id            Int      @id @default(autoincrement())
  dealHubspotId String   @unique @map("deal_hubspot_id") // one summary per deal (upsert pattern)
  summaryJson   Json     @map("summary_json")            // parsed JSON from Claude response
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("ai_summaries")
}

// Internal tasks — replaces Trello; case-linked or general business tasks
model InternalTask {
  id            Int          @id @default(autoincrement())
  dealHubspotId String?      @map("deal_hubspot_id") // null = general task (not case-linked)
  title         String
  notes         String?
  status        TaskStatus   @default(open)
  dueDate       DateTime?    @map("due_date") @db.Date
  category      TaskCategory
  source        String       @default("manual") @map("source") // always 'manual' in v1
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)

  deal Deal? @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("internal_tasks")
}

// Configurable settings — stageMap + ownerMap seeded in M2b; thresholds added in M7
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

// M9+: Unified multi-source event log — JustCall calls, Google emails, HubSpot (future), etc.
// deal_activities stays for HubSpot Layer 2 data; new sources write here.
model ActivityEvent {
  id            Int            @id @default(autoincrement())
  dealHubspotId String?        @map("deal_hubspot_id") // null = unmatched call (phone not in registry)
  source        ActivitySource
  externalId    String?        @map("external_id") // JustCall call ID, Gmail message ID, etc.
  type          String         // call | note | email | task | sms
  happenedAt    DateTime       @map("happened_at") @db.Timestamptz(6)
  durationSecs  Int?           @map("duration_secs")
  direction     String?        // inbound | outbound
  outcome       String?        // answered | voicemail | no_answer | busy
  fromNumber    String?        @map("from_number")   // E.164
  toNumber      String?        @map("to_number")     // E.164
  agentId       String?        @map("agent_id")      // JustCall agent ID or HubSpot owner ID
  body          String?        // note text / email excerpt / call transcript
  metadata      Json?
  rawPayload    Json?          @map("raw_payload")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  deal Deal? @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)

  @@unique([source, externalId], name: "activity_events_dedup")
  @@index([dealHubspotId, happenedAt])
  @@index([source, happenedAt])
  @@map("activity_events")
}

// M9+: E.164 phone registry — populated from deal_contacts during Layer 2 sync.
// Used to match JustCall call logs (by to_number) to deals without a deal ID.
model PhoneNumber {
  id            Int         @id @default(autoincrement())
  numberE164    String      @map("number_e164")     // e.g., +14045551234
  dealHubspotId String?     @map("deal_hubspot_id") // null if not yet matched to a deal
  contactName   String?     @map("contact_name")
  status        PhoneStatus @default(unknown)
  lastSeenAt    DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  deal Deal? @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)

  @@index([numberE164])
  @@index([dealHubspotId])
  @@map("phone_numbers")
}

// M9+: Operational state per deal per pipeline group.
// One row per (deal, pipeline). Auto-computed from event data in future; seeded for now.
model PipelineState {
  id            Int           @id @default(autoincrement())
  dealHubspotId String        @map("deal_hubspot_id")
  pipeline      PipelineGroup
  status        String        @default("not_started") // not_started | active | completed | blocked
  enteredAt     DateTime?     @map("entered_at") @db.Timestamptz(6)
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)

  @@unique([dealHubspotId, pipeline])
  @@map("pipeline_states")
}

// M9+: Integration registry — one row per external data source.
// Gate: check is_active before running any sync for a source.
// config holds non-secret options (lookback days, max records per sync, etc.)
// Secrets (API keys) live in environment variables only — never in this table.
model SyncSource {
  id           Int       @id @default(autoincrement())
  name         String    @unique // HUBSPOT | JUSTCALL | GOOGLE
  isActive     Boolean   @default(false) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  config       Json?     // e.g., { "maxRecordsPerSync": 500, "lookbackDays": 90 }
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("sync_sources")
}
