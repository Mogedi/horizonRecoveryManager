generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: no url/directUrl here. See prisma.config.ts (CLI) and src/lib/db/client.ts (app).
}

// M9+: Multi-source activity event type
enum ActivitySource {
  HUBSPOT
  JUSTCALL
  GOOGLE
  USER
  AI
}

// M9+: Phone number status for dead number detection
enum PhoneStatus {
  active
  disconnected
  invalid
  unknown
}


enum SnoozeCategory {
  waiting_on_attorney
  waiting_on_county
  waiting_on_client
  waiting_on_documents
  waiting_on_probate
  filed_normal_wait
  other
}

enum TaskCategory {
  case
  business
  vendor
  legal
  networking
  other
}

enum TaskStatus {
  open
  done
}

// Phase 1 (Hermes): AI-interpretation layer enums.
// case_analysis is append-only; agents INSERT rows, never overwrite.
enum AnalysisType {
  triage
  priority
  legal_review
  document_review
  attorney_recommendation
}

enum AnalysisSource {
  agent // produced by an automated agent (Hermes, the manual summary button, future Opus/Qwen/Gemini)
  human // produced/edited by Mo
}

// Mirrors CaseHealthStatus in src/lib/case/types.ts — keep the two in sync.
enum CaseHealth {
  active
  waiting
  blocked
  on_track
  unknown
}

enum CasePriority {
  urgent
  high
  normal
  low
}

// Layer 1 cache — all deals in the pipeline
model Deal {
  id               Int       @id @default(autoincrement())
  hubspotId        String    @unique @map("hubspot_id")
  name             String?
  stage            String?   // stage ID — resolve to name via stageMap; never compare raw strings
  pipeline         String?
  ownerId          String?   @map("owner_id") // mostly Marwa (data entry) — not used for routing
  amount           Decimal?  @db.Decimal(12, 2) // primary display value — confirmed 100% populated
  estimatedSurplus Decimal?  @map("estimated_surplus") @db.Decimal(12, 2) // null on all current deals
  closeDate        DateTime? @map("close_date") @db.Date
  lastActivityDate DateTime? @map("last_activity_date") @db.Timestamptz(6) // notes_last_updated
  stageEnteredAt   DateTime? @map("stage_entered_at") @db.Timestamptz(6)   // hs_v2_date_entered_current_stage
  lastModified     DateTime? @map("last_modified") @db.Timestamptz(6)      // hs_lastmodifieddate — delta filter
  contactCount     Int       @default(0) @map("contact_count")
  propertyAddress  String?   @map("property_address") // properties_address
  county           String?                            // enumeration: 25 GA counties + "Other"
  parcelId         String?   @map("parcel_id")        // parcel_id__deal
  taxSaleDate      DateTime? @map("tax_sale_date") @db.Date
  hubspotUrl       String?   @map("hubspot_url")
  rawPayload       Json?     @map("raw_payload")
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  // M9+ denorm cache — populated by JustCall sync; avoids JOIN on every attention queue load
  callAttemptCount  Int       @default(0) @map("call_attempt_count")
  lastCallAttemptAt DateTime? @map("last_call_attempt_at") @db.Timestamptz(6)

  // Google Drive — populated by drive indexing job; null until indexed
  driveFolderId       String?   @map("drive_folder_id")
  driveFolderUrl      String?   @map("drive_folder_url")
  driveFolderPath     String?   @map("drive_folder_path")      // e.g. "HorizonRecovery Onboarding > Georgia Cases > ..."
  driveFilesCache     Json?     @map("drive_files_cache")      // DriveFileEntry[] — cached at index time
  driveCacheUpdatedAt DateTime? @map("drive_cache_updated_at") @db.Timestamptz(6)
  docVerification     Json?     @map("doc_verification")       // FullVerificationReport — cached AI doc check
  docVerificationAt   DateTime? @map("doc_verification_at")   @db.Timestamptz(6)

  // HubSpot browser screenshot check — populated by hubspot-check route (manual only)
  hubspotCheck        Json?     @map("hubspot_check")         // HubSpotDriveCheckResult sans screenshotBase64
  hubspotCheckAt      DateTime? @map("hubspot_check_at")      @db.Timestamptz(6)
  lastRefreshedAt     DateTime? @map("last_refreshed_at")     @db.Timestamptz(6) // last on-demand per-case refresh (HubSpot+calls+email)
  hubspotScreenshot   String?   @map("hubspot_screenshot")    // JPEG base64, ~100-200KB
  // Queryable summary columns — extracted from hubspotCheck for fast filtering/sorting
  hubspotFilesLinked  Boolean?  @map("hubspot_files_linked")  // true = all files linked; false = gaps found
  hubspotMissingCount Int?      @map("hubspot_missing_count") // count of missing files (0 when all linked)
  // Per-doc-type status array — [{type, label, linked, fileName}] — GIN-indexed for @> queries
  // e.g. WHERE hubspot_doc_status @> '[{"type":"tax_sale_deed","linked":false}]'
  hubspotDocStatus    Json?     @map("hubspot_doc_status")

  activities     DealActivity[]
  contacts       DealContact[]
  snoozes        DealSnooze[]
  aiSummary      AiSummary?
  caseAnalyses   CaseAnalysis[]   // Phase 1 (Hermes) — append-only AI interpretation
  tasks          InternalTask[]
  activityEvents ActivityEvent[]  // M9+
  phoneNumbers   PhoneNumber[]    // M9+

  @@map("deals")
}

// Layer 2 cache — notes, emails, calls, tasks per deal (on demand only)
model DealActivity {
  id            Int       @id @default(autoincrement())
  dealHubspotId String    @map("deal_hubspot_id")
  type          String    // note | email | call | task
  body          String?   // HTML-stripped for notes; plain text for others
  authorOwnerId String?   @map("author_owner_id") // hubspot_owner_id on engagement
  direction     String?   // inbound | outbound (email direction — values not fully confirmed)
  timestamp     DateTime? @db.Timestamptz(6)
  metadata      Json?
  rawPayload    Json?     @map("raw_payload")
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("deal_activities")
}

// Layer 2 cache — contacts linked to a deal
model DealContact {
  id               Int      @id @default(autoincrement())
  dealHubspotId    String   @map("deal_hubspot_id")
  contactHubspotId String?  @map("contact_hubspot_id")
  name             String?
  contactType      String?  @map("contact_type")     // contact_type1: owner, heir, attorney, etc.
  ownershipStatus  String?  @map("ownership_status") // ownership_contact_status1
  isDeceased       Boolean  @default(false) @map("is_deceased")
  doNotContact     Boolean  @default(false) @map("do_not_contact")
  phoneNumbers     Json?    @map("phone_numbers") // validated array from all 11 phone field variants
  emailList        Json?    @map("email_list")
  address          String?  @map("address")
  city             String?  @map("city")
  state            String?  @map("state")
  zip              String?  @map("zip")
  rawPayload       Json?    @map("raw_payload")
  syncedAt         DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@index([dealHubspotId])
  @@map("deal_contacts")
}

// Snooze state — internal, not from HubSpot
model DealSnooze {
  id            Int            @id @default(autoincrement())
  dealHubspotId String         @map("deal_hubspot_id")
  category      SnoozeCategory
  freeformNote  String?        @map("freeform_note")
  snoozeUntil   DateTime       @map("snooze_until") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  wokeAt        DateTime?      @map("woke_at") @db.Timestamptz(6)
  idempotencyKey String?       @unique @map("idempotency_key") // agent retry-dedup; null for UI snoozes

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("deal_snoozes")
}

// API usage tracking — daily call counter read from here (not in-memory)
model SyncLog {
  id           Int       @id @default(autoincrement())
  syncType     String?   @map("sync_type")      // layer1_all | layer2_deal | manual
  apiCallsMade Int?      @map("api_calls_made")
  dealsSynced  Int?      @map("deals_synced")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  error        String?

  @@map("sync_log")
}

// AI-generated per-deal summaries — generated on demand, never auto-triggered
model AiSummary {
  id            Int      @id @default(autoincrement())
  dealHubspotId String   @unique @map("deal_hubspot_id") // one summary per deal (upsert pattern)
  summaryJson   Json     @map("summary_json")            // parsed JSON from Claude response
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("ai_summaries")
}

// Phase 1 (Hermes): append-only AI-interpretation layer.
// Every agent run INSERTs a new row — never an update. CurrentState derives from the latest
// `triage` row (with ai_summaries fallback). Business facts are NEVER written here.
// source/actor/provider/model are split so future agents (Opus, Qwen, Gemini) stay distinguishable.
model CaseAnalysis {
  id                   Int            @id @default(autoincrement())
  dealHubspotId        String         @map("deal_hubspot_id")
  analysisType         AnalysisType   @default(triage) @map("analysis_type")
  source               AnalysisSource
  actor                String         // 'hermes' | 'manual-button' | 'mo'
  provider             String?        // 'anthropic' | 'ollama' | null
  model                String?        // 'claude-sonnet-4-6', etc.
  health               CaseHealth     @default(unknown)
  priority             CasePriority   @default(normal)
  statusLabel          String?        @map("status_label")        // freeform "Waiting on County Attorney" → CurrentState.status
  blockers             Json           @default("[]")              // string[]
  recommendations      Json           @default("[]")              // string[]
  risks                Json           @default("[]")              // string[]
  nextAction           String?        @map("next_action")
  lastMeaningfulActivity String?      @map("last_meaningful_activity")
  moActionRequired     Boolean        @default(false) @map("mo_action_required")
  confidence           Float?         // 0..1
  reasoning            String?        @db.Text
  generatedFrom        String?        @map("generated_from")      // what inputs fed the analysis
  inputHash            String?        @map("input_hash")          // hash of the facts — skip-if-unchanged
  supersedesAnalysisId Int?           @map("supersedes_analysis_id") // future approved-analysis chains (soft pointer)
  correlationId        String?        @map("correlation_id")      // ties one workflow's writes together
  idempotencyKey       String?        @unique @map("idempotency_key")
  rawPayload           Json?          @map("raw_payload")         // full agent output
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)

  @@index([dealHubspotId, analysisType, createdAt])
  @@index([correlationId])
  @@map("case_analyses")
}

// Phase 1 (Hermes): audit trail for agent-originated writes — the safety net that replaces
// the per-write manual review. One row per agent mutation, with full before/after payloads.
model AgentAuditLog {
  id             Int      @id @default(autoincrement())
  actor          String   // 'hermes'
  action         String   // 'create_analysis' | 'create_task' | 'complete_task' | 'delete_task' | 'snooze' | 'unsnooze'
  target         String?  // dealHubspotId or task id
  route          String?
  method         String?
  correlationId  String?  @map("correlation_id")
  idempotencyKey String?  @map("idempotency_key")
  requestMeta    Json?    @map("request_meta") // { ip, userAgent, requestId }
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actor, createdAt])
  @@index([correlationId])
  @@map("agent_audit_log")
}

// Internal tasks — replaces Trello; case-linked or general business tasks
model InternalTask {
  id            Int          @id @default(autoincrement())
  dealHubspotId String?      @map("deal_hubspot_id") // null = general task (not case-linked)
  title         String
  notes         String?
  status        TaskStatus   @default(open)
  dueDate       DateTime?    @map("due_date") @db.Date
  category      TaskCategory
  source        String       @default("manual") @map("source") // 'manual' (UI) | 'hermes' (agent)
  idempotencyKey String?     @unique @map("idempotency_key") // agent retry-dedup; null for UI tasks
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)

  deal Deal? @relation(fields: [dealHubspotId], references: [hubspotId])

  @@map("internal_tasks")
}

// Configurable settings — stageMap + ownerMap seeded in M2b; thresholds added in M7
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

// Learned per-sender rule for Gmail body-pulling — keeps token/storage cost down by deciding,
// once per sender, whether their email is case-related (pull full body) or noise (headers only).
model EmailSenderRule {
  id             Int      @id @default(autoincrement())
  sender         String   @unique // lowercased email address (or domain)
  pullBody       Boolean  @map("pull_body")
  classification String?  // 'case_related' | 'noise' | 'unknown'
  reason         String?
  confidence     Float?
  source         String   @default("auto") // 'auto' (Haiku) | 'heuristic' | 'manual'
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_sender_rules")
}

// M9+: Unified multi-source event log — JustCall calls, Google emails, HubSpot (future), etc.
// deal_activities stays for HubSpot Layer 2 data; new sources write here.
model ActivityEvent {
  id            Int            @id @default(autoincrement())
  dealHubspotId String?        @map("deal_hubspot_id") // null = unmatched call (phone not in registry)
  source        ActivitySource
  externalId    String?        @map("external_id") // JustCall call ID, Gmail message ID, etc.
  type          String         // call | note | email | task | sms
  happenedAt    DateTime       @map("happened_at") @db.Timestamptz(6)
  durationSecs  Int?           @map("duration_secs")
  direction     String?        // inbound | outbound
  outcome       String?        // answered | voicemail | no_answer | busy
  fromNumber    String?        @map("from_number")   // E.164
  toNumber      String?        @map("to_number")     // E.164
  agentId       String?        @map("agent_id")      // JustCall agent ID or HubSpot owner ID
  body          String?        // note text / email excerpt / call transcript
  metadata      Json?
  rawPayload    Json?          @map("raw_payload")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  deal       Deal?           @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)
  transcript CallTranscript?

  @@unique([source, externalId], name: "activity_events_dedup")
  @@index([dealHubspotId, happenedAt])
  @@index([source, happenedAt])
  @@map("activity_events")
}

// M9+: E.164 phone registry — populated from deal_contacts during Layer 2 sync.
// Used to match JustCall call logs (by to_number) to deals without a deal ID.
model PhoneNumber {
  id            Int         @id @default(autoincrement())
  numberE164    String      @map("number_e164")     // e.g., +14045551234
  dealHubspotId String?     @map("deal_hubspot_id") // null if not yet matched to a deal
  contactName   String?     @map("contact_name")
  status        PhoneStatus @default(unknown)
  lastSeenAt    DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  deal Deal? @relation(fields: [dealHubspotId], references: [hubspotId], onDelete: Cascade)

  @@index([numberE164])
  @@index([dealHubspotId])
  @@map("phone_numbers")
}

// M9+: Operational state per deal per pipeline group.
// One row per (deal, pipeline). Auto-computed from event data in future; seeded for now.

// Call transcript + classification — written by call-classifier microservice only.
// One row per ActivityEvent (outbound answered calls only). Never written by sync.
model CallTranscript {
  id              Int       @id @default(autoincrement())
  activityEventId Int       @unique @map("activity_event_id")
  transcript      String    @db.Text       // full Whisper output
  classification  String?                  // 'live' | 'voicemail' | 'disconnected' | 'unknown'
  summary         String?   @db.Text       // Claude summary — live calls only
  whisperSecs     Float?    @map("whisper_secs")  // audio duration from Whisper response metadata
  processedAt     DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)

  event ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)

  @@map("call_transcripts")
}

// M9+: Integration registry — one row per external data source.
// Gate: check is_active before running any sync for a source.
// config holds non-secret options (lookback days, max records per sync, etc.)
// Secrets (API keys) live in environment variables only — never in this table.
model SyncSource {
  id           Int       @id @default(autoincrement())
  name         String    @unique // HUBSPOT | JUSTCALL | GOOGLE
  isActive     Boolean   @default(false) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  config       Json?     // e.g., { "maxRecordsPerSync": 500, "lookbackDays": 90 }
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("sync_sources")
}

// ─── Research agent (find_person) ───────────────────────────────────────────────
// Browser-based people/property research for surplus recovery. Telemetry is first-class:
// every source call is logged so we can answer "which source is reliable / degrading?".
// caseId is the deal hubspot_id when tied to a deal, or null for ad-hoc searches from the
// research page. No hard FK — research can run standalone. See docs/research-agent-design.md.

model SourceAttempt {
  id             Int      @id @default(autoincrement())
  sourceId       String   @map("source_id")
  caseId         String?  @map("case_id")
  status         String   // success | blocked | captcha | empty | error
  blockReason    String?  @map("block_reason") // cloudflare | captcha | http_403 | http_429 | redirect | empty | parse
  url            String?
  latencyMs      Int      @map("latency_ms")
  candidateCount Int      @default(0) @map("candidate_count")
  proxyUsed      Boolean  @default(false) @map("proxy_used")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sourceId, createdAt])
  @@map("source_attempts")
}

model ResearchDossier {
  id         Int       @id @default(autoincrement())
  caseId     String?   @map("case_id")
  query      Json
  resolution Json
  candidates Json
  attempts   Json
  reviewed   Boolean   @default(false)
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  documents ResearchDocument[]

  @@index([caseId, createdAt])
  @@map("research_dossiers")
}

model ResearchDocument {
  id        Int      @id @default(autoincrement())
  caseId    String?  @map("case_id")
  dossierId Int?     @map("dossier_id")
  sourceId  String   @map("source_id")
  kind      String   // tax_deed | lien | property_card | obituary | screenshot
  label     String?
  mimeType  String   @map("mime_type")
  bytes     Bytes
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dossier ResearchDossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("research_documents")
}

model SuggestedSource {
  id        Int      @id @default(autoincrement())
  host      String   @unique
  url       String
  note      String?
  seenCount Int      @default(1) @map("seen_count")
  status    String   @default("new") // new | approved | rejected
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("suggested_sources")
}
